{
  "name": "desktop-resident-agent",
  "version": "0.0.157",
  "private": true,
  "license": "UNLICENSED",
  "author": "DesktopPetProject",
  "description": "A resident Windows companion with an auditable task loop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-panel-light.cjs && electron-vite build",
    "preview": "electron-vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:full": "vitest run",
    "test:smoke": "vitest run test/font-system.test.ts test/duration.test.ts test/tool-kill.test.tsx test/panel-tool-row-dom.test.tsx test/panel-asides-dom.test.tsx test/panel-avatar-preload-dom.test.tsx test/panel-library-divider-dom.test.tsx test/panel-library-layout-dom.test.tsx test/panel-right-rail-dom.test.tsx test/panel-context-threshold-dom.test.tsx test/goal-banner.test.tsx test/libraries.test.ts test/composer-suggestions.test.ts test/composer-suggestions.test.tsx test/timeline-nav.test.tsx test/timeline-groups.test.ts test/work-cluster.test.tsx test/panel-stop-command-dom.test.tsx test/settings-libraries-dom.test.tsx",
    "live2d:generate": "node tools/live2d-motion/generate.mjs",
    "live2d:validate": "node tools/live2d-motion/validate.mjs",
    "live2d:check": "npm run live2d:generate -- --check && npm run live2d:validate",
    "pack:dir": "npm run build && electron-builder --win --dir -c.electronDist=node_modules/electron/dist",
    "verify:asar": "node scripts/check-asar.cjs",
    "pack:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-release.ps1",
    "theme:build": "node scripts/build-panel-light.cjs",
    "predev": "node scripts/build-panel-light.cjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "koffi": "^3.3.4",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.22.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@iconify-json/material-symbols": "^1.2.97",
    "@iconify-json/ph": "^1.2.2",
    "@swc/core": "^1.13.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "local.desktop.resident.agent",
    "productName": "小鲸",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/uiohook-napi/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/renderer/assets/whale-tray-icon-pixel.png",
        "to": "whale-tray-icon-pixel.png"
      },
      {
        "from": "src/renderer/assets/whale-tray-icon-pixel-24.png",
        "to": "whale-tray-icon-pixel-24.png"
      },
      {
        "from": "src/renderer/assets/whale-tray-icon-pixel.ico",
        "to": "whale-tray-icon-pixel.ico"
      },
      {
        "from": "reference/dsh-runtime/node_modules",
        "to": "dsh/node_modules",
        "filter": [
          "**/*",
          "!**/.pnpm/@deepseek-ai+libreoffice-kit-*",
          "!**/.pnpm/@deepseek-ai+dsh-experiment*",
          "!**/.pnpm/@anthropic-ai+sdk*",
          "!**/.pnpm/@google+genai*",
          "!**/.pnpm/openai@*",
          "!**/.pnpm/@deepseek-ai+dsh-web-frontend*",
          "!**/.pnpm/@deepseek-ai+dsh-web-app*",
          "!**/.pnpm/@deepseek-ai+dsh-client-ui-*",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.mts",
          "!**/*.d.cts",
          "!**/*.tsbuildinfo",
          "!**/test/**",
          "!**/tests/**",
          "!**/docs/**",
          "!**/examples/**",
          "!**/*.md",
          "!**/README*"
        ]
      },
      {
        "from": "reference/dsh-runtime/package.json",
        "to": "dsh/package.json"
      },
      {
        "from": "scripts/wps-mcp-server.cjs",
        "to": "wps-mcp-server.cjs"
      },
      {
        "from": "scripts/wps-com.ps1",
        "to": "wps-com.ps1"
      },
      {
        "from": "scripts/pet-mcp-bridge.cjs",
        "to": "pet-mcp-bridge.cjs"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "icon": "src/renderer/assets/whale-tray-icon-pixel.ico",
      "executableName": "Whale Companion Preview",
      "target": "dir"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "src/renderer/assets/whale-tray-icon-pixel.ico",
      "uninstallerIcon": "src/renderer/assets/whale-tray-icon-pixel.ico",
      "installerHeaderIcon": "src/renderer/assets/whale-tray-icon-pixel.ico"
    }
  }
}
